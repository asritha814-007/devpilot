# ==============================================================================
# DevPilot Environment Configuration
# ==============================================================================

# Server configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite:///./devpilot.db

# AI Provider Configuration (Optional - DevPilot works offline with rule-based heuristics if no key is set)
# Provide either Google Gemini or OpenAI API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback / alternate provider
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
